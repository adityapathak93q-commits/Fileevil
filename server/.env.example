# Port the signaling server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS / Socket.IO
# In production this MUST be your real frontend origin(s), e.g. https://filesync.example.com
CLIENT_ORIGINS=http://localhost:3000

# Max participants allowed per room (mesh network cost grows ~N^2, keep this sane)
MAX_ROOM_SIZE=8

# Room time-to-live in minutes since last activity, after which it is auto-cleaned
ROOM_TTL_MINUTES=180

# Max signaling messages per socket per RATE_LIMIT_WINDOW_MS (basic abuse protection)
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_MS=60000

# STUN servers (comma-separated URLs), sent to clients so they never need to be hardcoded on the frontend
STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478

# Optional TURN server, required for reliable cross-network / restrictive-NAT connectivity.
# Leave blank to run STUN-only (will fail for some users behind symmetric NATs / strict firewalls).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
